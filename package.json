{
  "name": "attendence-portal",
  "version": "1.0.0",
  "description": "Full-stack Attendance Management Portal with Mon-Fri rules, half-day shifts, and Admin monitor",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
    "build": "node build.cjs",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\""
  },
  "keywords": [
    "attendance",
    "portal",
    "react",
    "express",
    "sqlite",
    "workdays"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.15",
    "pg": "^8.23.1"
  }
}
